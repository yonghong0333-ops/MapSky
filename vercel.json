{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/transit/thsr",
      "destination": "/api/weather/wind?transit=thsr"
    },
    {
      "source": "/api/transit/tra",
      "destination": "/api/weather/wind?transit=tra"
    },
    {
      "source": "/api/transit/krtc",
      "destination": "/api/weather/wind?transit=krtc"
    },
    {
      "source": "/api/weather/cloud",
      "destination": "/api/weather/wind?type=cloud"
    },
    {
      "source": "/api/store/gacha-odds",
      "destination": "/api/auth/session?action=gacha-odds"
    },
    {
      "source": "/api/store/gacha-draw",
      "destination": "/api/auth/session?action=gacha-draw"
    },
    {
      "source": "/api/weather/skyline-image",
      "destination": "/api/weather/astro?type=skyline-image"
    },
    {
      "source": "/api/weather/skyline",
      "destination": "/api/weather/astro?type=skyline-list"
    },
    {
      "source": "/api/auth/callback/microsoft",
      "destination": "/api/auth/callback?provider=microsoft"
    },
    {
      "source": "/api/auth/callback/x",
      "destination": "/api/auth/callback?provider=x"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/renderer.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/style.css",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/web-shim.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ],
  "redirects": [
    {
      "source": "/downloads/MapSky_Installbox.dmg",
      "destination": "https://github.com/yonghong0333-ops/MapSky/releases/download/downloads-mac-installer/MapSky_Installbox.dmg",
      "permanent": false
    },
    {
      "source": "/downloads/MapSky_Installbox.exe",
      "destination": "https://github.com/yonghong0333-ops/MapSky/releases/download/desktop-v1.0.0/MapSky_Installbox.exe",
      "permanent": false
    }
  ]
}
