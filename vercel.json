{
  "version": 2,
  "rewrites": [
    { "source": "/api/auth/callback/microsoft", "destination": "/api/auth/callback?provider=microsoft" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
