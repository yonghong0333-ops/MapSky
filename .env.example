# 複製這個檔案為 .env（本機測試用），或直接在 Vercel 專案的
# Settings → Environment Variables 裡逐一貼上（正式環境不要用 .env 檔）。
#
# ⚠️ 原本 zip 檔裡 launcher/auth/providers.js 寫死的那組 clientSecret 已經外流過，
# 部署網頁版之前請先去各平台「重新產生」一組新的，再填在這裡。

# ---- 用來簽章登入 session 的密鑰，隨便一組長隨機字串即可 ----
# 產生方式：openssl rand -hex 32
SESSION_SECRET=

# ---- 中央氣象署 (CWA) 開放資料 API 授權碼 ----
# 免費申請：https://opendata.cwa.gov.tw/user/authkey
CWA_API_KEY=

# ---- Google OAuth ----
# 建立方式：https://console.cloud.google.com/apis/credentials
# Authorized redirect URI 填：https://你的網域/api/auth/callback?provider=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Facebook OAuth ----
# 建立方式：https://developers.facebook.com/apps
# Valid OAuth Redirect URI 填：https://你的網域/api/auth/callback?provider=facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---- Microsoft OAuth (Azure AD / Entra ID) ----
# 建立方式：https://portal.azure.com → App registrations
# Redirect URI 填：https://你的網域/api/auth/callback?provider=microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- GitHub OAuth ----
# 建立方式：https://github.com/settings/developers
# Authorization callback URL 填：https://你的網域/api/auth/callback?provider=github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Discord OAuth ----
# 建立方式：https://discord.com/developers/applications
# Redirect 填：https://你的網域/api/auth/callback?provider=discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---- Yahoo OAuth ----
# 建立方式：https://developer.yahoo.com/apps/
# Redirect URI 填：https://你的網域/api/auth/callback?provider=yahoo（Yahoo 強制要求 https，Vercel 預設就是 https，沒問題）
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
