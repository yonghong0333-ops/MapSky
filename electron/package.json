{
  "name": "mapsky-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "MapSky —— Windows 桌面版（載入線上 map-sky.vercel.app 的原生視窗殼）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "publish:win": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mapsky.weather.desktop",
    "productName": "MapSky",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build-icon.ico",
      "icons/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "yonghong0333-ops",
      "repo": "MapSky"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MapSky",
      "artifactName": "MapSky-Setup.${ext}"
    }
  }
}
