{
  "name": "mapsky-desktop",
  "version": "26.3.0-alpha.1",
  "private": true,
  "description": "MapSky —— 桌面版（載入線上 map-sky.vercel.app 的原生視窗殼）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "publish:win": "electron-builder --win --x64 --publish always",
    "dist:mac": "electron-builder --mac --universal",
    "publish:mac": "electron-builder --mac --universal --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mapsky.weather.desktop",
    "productName": "MapSky",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build-icon.ico",
      "build-icon.icns",
      "installbox.ico",
      "installbox.icns",
      "icons/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "yonghong0333-ops",
      "repo": "MapSky"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MapSky",
      "artifactName": "MapSky_Installbox.${ext}",
      "installerIcon": "installbox.ico",
      "uninstallerIcon": "installbox.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build-icon.icns",
      "category": "public.app-category.weather",
      "identity": null,
      "extendInfo": {
        "NSLocationWhenInUseUsageDescription": "MapSky 需要使用您的位置來顯示所在地的天氣資訊。",
        "NSLocationUsageDescription": "MapSky 需要使用您的位置來顯示所在地的天氣資訊。"
      }
    },
    "dmg": {
      "title": "MapSky",
      "icon": "installbox.icns",
      "artifactName": "MapSky_Installbox.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
